/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /CREATE_GLOBAL_MAXIMUM=FALSE
! /CREATE_TRIAL_MAXIMUM=FALSE
;

! Angle between rear to lead foot (right to left) at PLANT in pelvis CS xy-plane
Transform_Data_Coordinate_System
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FOOT_VECTOR_RtoL
/FROM_SEGMENT_CS=LAB
/TO_SEGMENT_CS=RPV
/RESULT_TYPES=DERIVED
/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=FOOT_VECTOR_RtoL_RPV_CS
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/ORIENTATION_ONLY=TRUE
! /USE_DATA_RATE=FALSE
;

Metric_Signal_Value_At_Event
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FOOT_VECTOR_RtoL_RPV_CS
/RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=FOOT_VECTOR_RtoL_RPV_CS_PLANT
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
! /SIGNAL_COMPONENTS=
! /COMPONENT_SEQUENCE=
/EVENT_NAME=PLANT
! /EVENT_INSTANCE=0
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Metric_Explicit
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME= FOOT_ANGLE_PLANT
/METRIC_VALUE= atan( METRIC::PROCESSED::FOOT_VECTOR_RtoL_RPV_CS_PLANT::X, METRIC::PROCESSED::FOOT_VECTOR_RtoL_RPV_CS_PLANT::Y) * 180 / pi()
;

! Difference in A/P position of the feet at PLANT (+ = rear (right) foot in front)
Metric_Signal_Value_At_Event
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FOOT_VECTOR_LtoR_RPV_CS
/RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME= STANCE_LENGTH
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/SIGNAL_COMPONENTS=Y
! /COMPONENT_SEQUENCE=
/EVENT_NAME=PLANT
! /EVENT_INSTANCE=0
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

