;

! START event
Signal_Magnitude
/SIGNAL_TYPES=KINETIC_KINEMATIC
/SIGNAL_FOLDER=RPV
/SIGNAL_NAMES=CGVel
/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=RPV_CGVEL_MAG
