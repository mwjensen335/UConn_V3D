/THRESHOLD=1
/ON_ASCENT=TRUE
! /ON_DESCENT=
/FRAME_WINDOW=10
! /ENSURE_FRAMES_BEFORE=FALSE
/ENSURE_FRAMES_AFTER=TRUE
;

! detecting BACKPEDAL
Metric_Maximum
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=RPV_CGVEL_MAG_MAX
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=RPV_CGVEL_MAG
! /COMPONENT_SEQUENCE=
/EVENT_SEQUENCE=
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
/CREATE_GLOBAL_MAXIMUM=FALSE
/CREATE_TRIAL_MAXIMUM=TRUE
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=BACKPEDAL_PRESENT
/EXPRESSION= METRIC::PROCESSED::RPV_CGVEL_MAG_MAX > 1
! /AS_INTEGER=TRUE
;

Metric_Explicit
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=BACKPEDAL
/METRIC_VALUE=1
;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=BACKPEDAL_PRESENT
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=BACKPEDAL_ABSENT
/EXPRESSION= METRIC::PROCESSED::RPV_CGVEL_MAG_MAX < 1
! /AS_INTEGER=TRUE
;

Metric_Explicit
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=BACKPEDAL
/METRIC_VALUE=0
;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=BACKPEDAL_ABSENT
;

