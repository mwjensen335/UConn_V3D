/EVENT_INSTANCE=1
/FRAME_WINDOW=8
! /THRESHOLD=
;

! PLANT event (only created if START exists)
Event_Threshold
/RESULT_EVENT_NAME=PLANT
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=RFT_CGVEL_MAG
/SIGNAL_COMPONENTS=X
/FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=START+EARLY_COCKING
! /EXCLUDE_EVENTS=
/EVENT_SEQUENCE_INSTANCE=1
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=-1
/THRESHOLD=0.25
! /ON_ASCENT=
/ON_DESCENT=TRUE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

! ------------------------------------- LEFT-HANDED EVENTS
Select_Active_File
/FILE_NAME=ALL_FILES
/QUERY=THROW & LEFT
;

! EARLY_COCKING event
Event_Minimum
/RESULT_EVENT_NAME=EARLY_COCKING
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_FOLDER=ORIGINAL
