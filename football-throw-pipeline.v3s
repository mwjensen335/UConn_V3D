! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=1
! /FRAME_WINDOW=8
! /THRESHOLD=
;

! FOLLOW_THROUGH event
Metric_Signal_Value_At_Event
/SIGNAL_TYPES=FRAME_NUMBERS
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=TIME
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=RELEASE_TIME
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
! /SIGNAL_COMPONENTS=
! /COMPONENT_SEQUENCE=
/EVENT_NAME=RELEASE
! /EVENT_INSTANCE=0
/GENERATE_MEAN_AND_STDDEV=FALSE
/APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Metric_Explicit
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=FOLLOW_THROUGH_FRAME
/METRIC_VALUE= ADD(METRIC::PROCESSED::RELEASE_TIME,0.1)
;

Event_Explicit
/EVENT_NAME=FOLLOW_THROUGH
! /FRAME= 
/TIME=METRIC::PROCESSED::FOLLOW_THROUGH_FRAME
;

! END event
Transform_Data_Coordinate_System
/SIGNAL_TYPES=KINETIC_KINEMATIC
/SIGNAL_FOLDER=LFA
/SIGNAL_NAMES=DistEndPos
