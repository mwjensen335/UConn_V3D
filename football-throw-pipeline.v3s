! --------------------------------------------- RIGHT THROW METRICS
Select_Active_File
/FILE_NAME=ALL_FILES
/QUERY=THROW & RIGHT
;

! Peak elbow extension velocity
Metric_Maximum
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=PEAK_R_ELBOW_EXT_VEL
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=R_ELBOW_EXT_VEL
! /COMPONENT_SEQUENCE=
/EVENT_SEQUENCE= LATE_COCKING + END
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /CREATE_GLOBAL_MAXIMUM=FALSE
! /CREATE_TRIAL_MAXIMUM=FALSE
;

! Peak shoulder rotation velocity
Metric_Maximum
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=PEAK_R_SHOULDER_ROT_VEL
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
