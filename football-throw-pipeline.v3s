! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=1
! /FRAME_WINDOW=8
/THRESHOLD=-45
;

! LATE_COCKING event
Event_Minimum
/RESULT_EVENT_NAME=LATE_COCKING
