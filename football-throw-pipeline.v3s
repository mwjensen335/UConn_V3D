!------------------------------------------------------------------------------------------------ METRICS
! ** Metrics **
! ;

!---------------------------------------------------------------------------------------------- THROW METRICS
Select_Active_File
/FILE_NAME=ALL_FILES
/QUERY=THROW
;

! Step Count
Metric_Event_Count
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=RFT_UP_COUNT
/EVENT_TO_COUNT=RFT_UP
! /TIME_INTERVAL=
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
/GENERATE_COUNT_TOTAL_IN_GLOBAL=FALSE
;

Metric_Event_Count
/RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=LFT_UP_COUNT
/EVENT_TO_COUNT=LFT_UP
! /TIME_INTERVAL=
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
/GENERATE_COUNT_TOTAL_IN_GLOBAL=FALSE
;

Add_Signals
/SIGNAL_TYPES=METRIC+METRIC
/SIGNAL_FOLDER=PROCESSED+PROCESSED
/SIGNAL_NAMES=RFT_UP_COUNT+LFT_UP_COUNT
! /COMPONENT_SEQUENCE=
/RESULT_FOLDER=PROCESSED
/RESULT_NAME=STEP_COUNT
;

! Time to Ready
Metric_Time_Between_Events
/RESULT_METRIC_NAME=TIME_TO_READY
/RESULT_METRIC_FOLDER=PROCESSED
/EVENT_SEQUENCE=START+PLANT
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

! Peak Backpedal Velocity
Metric_Maximum
/RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=BACKPEDAL_PEAK_VEL
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=RPV_CGVEL_MAG
/COMPONENT_SEQUENCE=
/EVENT_SEQUENCE=START+PLANT
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /CREATE_GLOBAL_MAXIMUM=FALSE
! /CREATE_TRIAL_MAXIMUM=FALSE
;

Select_Active_File
/FILE_NAME=ALL_FILES
/QUERY=THROW & RIGHT
;

! Distance Covered During Backpedal (RIGHT)
Metric_Vector_Between_Events
/RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=BACKPEDAL_DISTANCE
/GENERATE_VECTOR_LENGTH_METRIC=TRUE
/START_SIGNAL_TYPE=KINETIC_KINEMATIC
/START_SIGNAL_FOLDER=RFT
/START_SIGNAL_NAME=CGPos
/END_SIGNAL_TYPE=KINETIC_KINEMATIC
/END_SIGNAL_FOLDER=RFT
/END_SIGNAL_NAME=CGPos
/EVENT_SEQUENCE=START+PLANT
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Select_Active_File
/FILE_NAME=ALL_FILES
/QUERY=THROW & LEFT
;

! Distance Covered During Backpedal (LEFT)
Metric_Vector_Between_Events
/RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=BACKPEDAL_DISTANCE
/GENERATE_VECTOR_LENGTH_METRIC=TRUE
/START_SIGNAL_TYPE=KINETIC_KINEMATIC
/START_SIGNAL_FOLDER=LFT
/START_SIGNAL_NAME=CGPos
/END_SIGNAL_TYPE=KINETIC_KINEMATIC
/END_SIGNAL_FOLDER=LFT
/END_SIGNAL_NAME=CGPos
/EVENT_SEQUENCE=START+PLANT
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Select_Active_File
/FILE_NAME=ALL_FILES
/QUERY=THROW
;

! Backpedal Angle
Transform_Data_Coordinate_System
/SIGNAL_TYPES=KINETIC_KINEMATIC
/SIGNAL_FOLDER=RPV
/SIGNAL_NAMES=CGPos
/FROM_SEGMENT_CS=Lab
/TO_SEGMENT_CS=Virtual Lab
/RESULT_TYPES=DERIVED
/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=RPV_CGPOS_WRT_VLAB
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
! /ORIENTATION_ONLY=FALSE
! /USE_DATA_RATE=FALSE
;

Metric_Vector_Between_Events
/RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=RPV_START_PLANT_VECTOR
/GENERATE_VECTOR_LENGTH_METRIC=FALSE
/START_SIGNAL_TYPE=DERIVED
/START_SIGNAL_FOLDER=PROCESSED
/START_SIGNAL_NAME=RPV_CGPOS_WRT_VLAB
/END_SIGNAL_TYPE=DERIVED
/END_SIGNAL_FOLDER=PROCESSED
/END_SIGNAL_NAME=RPV_CGPOS_WRT_VLAB
/EVENT_SEQUENCE=START+PLANT
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Metric_Explicit
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME= BACKPEDAL_ANGLE
/METRIC_VALUE= atan( METRIC::PROCESSED::RPV_START_PLANT_VECTOR::X, METRIC::PROCESSED::RPV_START_PLANT_VECTOR::Y) * 180 / pi()
;

! Peak pelvis rotational velocity
Metric_Maximum
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=PEAK_PELVIS_ROT_VEL
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=PELVIS_ROT_VEL
! /COMPONENT_SEQUENCE=
/EVENT_SEQUENCE= LATE_COCKING + END
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /CREATE_GLOBAL_MAXIMUM=FALSE
! /CREATE_TRIAL_MAXIMUM=FALSE
;

! Peak torso rotational velocity
Metric_Maximum
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=PEAK_TORSO_ROT_VEL
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=TORSO_ROT_VEL
! /COMPONENT_SEQUENCE=
/EVENT_SEQUENCE= LATE_COCKING + END
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /CREATE_GLOBAL_MAXIMUM=FALSE
! /CREATE_TRIAL_MAXIMUM=FALSE
;

! foot position vectors for various calculations
Evaluate_Expression
/EXPRESSION= KINETIC_KINEMATIC::RFT::ProxEndPos - KINETIC_KINEMATIC::LFT::ProxEndPos
! /SIGNAL_TYPES=
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
/RESULT_TYPES=DERIVED
/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=FOOT_VECTOR_LtoR
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Evaluate_Expression
/EXPRESSION= KINETIC_KINEMATIC::LFT::ProxEndPos - KINETIC_KINEMATIC::RFT::ProxEndPos
! /SIGNAL_TYPES=
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
/RESULT_TYPES=DERIVED
/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=FOOT_VECTOR_RtoL
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Transform_Data_Coordinate_System
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FOOT_VECTOR_RtoL
/FROM_SEGMENT_CS=LAB
/TO_SEGMENT_CS=RPV
/RESULT_TYPES=DERIVED
/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=FOOT_VECTOR_RtoL_RPV_CS
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/ORIENTATION_ONLY=TRUE
! /USE_DATA_RATE=FALSE
;

Transform_Data_Coordinate_System
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FOOT_VECTOR_LtoR
/FROM_SEGMENT_CS=LAB
/TO_SEGMENT_CS=RPV
/RESULT_TYPES=DERIVED
/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=FOOT_VECTOR_LtoR_RPV_CS
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/ORIENTATION_ONLY=TRUE
! /USE_DATA_RATE=FALSE
;

! Stance width at PLANT as % of height
Rectify
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FOOT_VECTOR_RtoL_RPV_CS
/RESULT_TYPES=DERIVED
/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=FOOT_DISTANCE_RtoL_RPV_CS_RECT
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=
;

Metric_Signal_Value_At_Event
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=FOOT_DISTANCE_RtoL_RPV_CS_RECT
/RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME= STANCE_WIDTH
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/SIGNAL_COMPONENTS=X
! /COMPONENT_SEQUENCE=
/EVENT_NAME=PLANT
! /EVENT_INSTANCE=0
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
! /RETAIN_NO_DATA_VALUES=FALSE
;

Metric_Explicit
! /RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=STANCE_WIDTH_NORM
/METRIC_VALUE= METRIC::PROCESSED::STANCE_WIDTH / METRIC::PROCESSED::HEIGHT
;

! Peak forward speed
Transform_Data_Coordinate_System
/SIGNAL_TYPES=KINETIC_KINEMATIC
/SIGNAL_FOLDER=Model
/SIGNAL_NAMES=CenterOfMassVelocity
/FROM_SEGMENT_CS=LAB
/TO_SEGMENT_CS=RPV
/RESULT_TYPES=DERIVED
/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=MODEL_FORWARD_VEL
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/ORIENTATION_ONLY=TRUE
! /USE_DATA_RATE=FALSE
;

Metric_Maximum
/RESULT_METRIC_FOLDER=PROCESSED
/RESULT_METRIC_NAME=PEAK_FORWARD_VEL
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=MODEL_FORWARD_VEL
/COMPONENT_SEQUENCE=Y
/EVENT_SEQUENCE=PLANT+RELEASE
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /CREATE_GLOBAL_MAXIMUM=FALSE
! /CREATE_TRIAL_MAXIMUM=FALSE
;

! Time from START to RELEASE
Metric_Time_Between_Events
/RESULT_METRIC_NAME=BALL_RELEASE_TIME
/RESULT_METRIC_FOLDER=PROCESSED
/EVENT_SEQUENCE=START+RELEASE
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

!---------------------------------------------------------------------------------------------- THROW ANGLE METRICS at EVENTS

! --------------------------- THROW UNILATERAL ANGLE METRICS
For_Each
/ITERATION_PARAMETER_NAME=ANGLE_METRIC_EVENT
! /ITERATION_PARAMETER_COUNT_NAME=
/ITEMS= PLANT + EARLY_COCKING + LATE_COCKING + RELEASE
;

! Neck flexion angle
Metric_Signal_Value_At_Event
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_FOLDER=ORIGINAL
