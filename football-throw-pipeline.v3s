!---------------------------------------------------------------------------------------- Football Throw Pipeline
! ** Football Throw Pipeline **
! ;

Assign_Tags_To_Files
/MOTION_FILE_NAMES=*throw_*
! /QUERY=
/TAGS=THROW
;

Assign_Tags_To_Files
/MOTION_FILE_NAMES=*_RH_*
! /QUERY=
/TAGS=RIGHT
;

Assign_Tags_To_Files
/MOTION_FILE_NAMES=*_LH_*
! /QUERY=
/TAGS=LEFT
;

!------------------------------------------------------------------------------------------------ SIGNAL PROCESSING
Select_Active_File
/FILE_NAME=ALL_FILES
! /QUERY=
;

Interpolate
/SIGNAL_TYPES=TARGET
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
! /RESULT_FOLDER=PROCESSED
! /RESULT_SUFFIX=
/MAXIMUM_GAP=15
! /NUM_FIT=3
! /POLYNOMIAL_ORDER=3
;

Lowpass_Filter
/SIGNAL_TYPES=TARGET
/SIGNAL_FOLDER=PROCESSED
! /SIGNAL_NAMES=
! /RESULT_FOLDER=PROCESSED
! /RESULT_SUFFIX=
! /FILTER_CLASS=BUTTERWORTH
/FREQUENCY_CUTOFF=12
! /NUM_REFLECTED=6
! /NUM_EXTRAPOLATED=0
! /TOTAL_BUFFER_SIZE=6
! /NUM_BIDIRECTIONAL_PASSES=1
;

!------------------------------------------------------------------------------------------------ SEGMENT ANGLES
! ** Segment Angles **
! ;

Compute_Model_Based_Data
/RESULT_NAME=PELVIS_LAB_ANGLE
/SUBJECT_TAG=ALL_SUBJECTS
/FUNCTION=JOINT_ANGLE
/SEGMENT=RPV
/REFERENCE_SEGMENT=LAB
/RESOLUTION_COORDINATE_SYSTEM=
! /USE_CARDAN_SEQUENCE=FALSE
! /NORMALIZATION=FALSE
