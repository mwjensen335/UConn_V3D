! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=1
! /FRAME_WINDOW=8
/THRESHOLD=-45
;

! RELEASE event
Event_Global_Maximum
/RESULT_EVENT_NAME=RELEASE
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_FOLDER=ANGULAR_VELOCITIES
/SIGNAL_NAMES=L_SHOULDER_ANGVEL
/SIGNAL_COMPONENTS=Z
/FRAME_OFFSET=0
