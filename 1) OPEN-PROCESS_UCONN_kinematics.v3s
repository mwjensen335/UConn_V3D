! Determine which Side touches first and use that as a global IC event
! Should improve this by looking across both toes and heels (in the event they land heel first)
! Trying to decide between vertical accel peak of either shank Com, foot COM, heel landmark or toe COM

Evaluate_Expression
/EXPRESSION=EVENT_LABEL::ORIGINAL::LFT_IC-EVENT_LABEL::ORIGINAL::RFT_IC
! /SIGNAL_TYPES=
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
! /SIGNAL_COMPONENTS=
! /RESULT_TYPES=DERIVED
! /RESULT_FOLDERS=PROCESSED
/RESULT_NAME=IC_DIFF
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Evaluate_Expression
/EXPRESSION=(((DERIVED::PROCESSED::IC_DIFF) >= 0) * EVENT_LABEL::ORIGINAL::RFT_IC) + (((DERIVED::PROCESSED::IC_DIFF) < 0) * EVENT_LABEL::ORIGINAL::LFT_IC) 
! /SIGNAL_TYPES=
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
! /SIGNAL_COMPONENTS=
!/RESULT_TYPES=TEXT_DATA
!/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=IC_EVENT_TIME
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Event_Explicit
/EVENT_NAME=IC
!/FRAME=
/TIME=DERIVED::PROCESSED::IC_EVENT_TIME
;

! Determine which Knee Max happens LAST and use that as global end of landing phase event

Event_Global_Maximum
/RESULT_EVENT_NAME=RKNEE_MAX
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=RIGHT_KNEE_ANGLE
/SIGNAL_COMPONENTS=X
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=IC+RPV_VEL_MAX2
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /THRESHOLD=
;

Event_Global_Maximum
/RESULT_EVENT_NAME=LKNEE_MAX
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=LEFT_KNEE_ANGLE
/SIGNAL_COMPONENTS=X
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=IC+RPV_VEL_MAX2
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /THRESHOLD=
;

Evaluate_Expression
/EXPRESSION=EVENT_LABEL::ORIGINAL::LKNEE_MAX-EVENT_LABEL::ORIGINAL::RKNEE_MAX
! /SIGNAL_TYPES=
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
! /SIGNAL_COMPONENTS=
! /RESULT_TYPES=DERIVED
! /RESULT_FOLDERS=PROCESSED
/RESULT_NAME=END_DIFF
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Evaluate_Expression
/EXPRESSION=(((DERIVED::PROCESSED::END_DIFF) >= 0) * EVENT_LABEL::ORIGINAL::RKNEE_MAX) + (((DERIVED::PROCESSED::END_DIFF) < 0) * EVENT_LABEL::ORIGINAL::LKNEE_MAX) 
! /SIGNAL_TYPES=
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
! /SIGNAL_COMPONENTS=
!/RESULT_TYPES=TEXT_DATA
!/RESULT_FOLDERS=PROCESSED
/RESULT_NAME=END_PHASE_EVENT_TIME
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Event_Explicit
/EVENT_NAME=END_PHASE
!/FRAME=
/TIME=DERIVED::PROCESSED::END_PHASE_EVENT_TIME
