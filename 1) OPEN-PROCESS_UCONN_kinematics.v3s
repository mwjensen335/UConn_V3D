!LOAD FILES AND CREATE MODEL

File_New

;

Set_Pipeline_Parameter_To_Folder_Path
/PARAMETER_NAME=FOLDER
/PARAMETER_VALUE=
! /FROM_MOTION_FILE_IN_WORKSPACE=
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_APPEND=
! /SET_PROMPT=Select a directory
! /ALPHABETIZE=TRUE
;

File_Open
/FILE_NAME=::FOLDER&*_DLS_*_pose_filt_0.c3d
! /FILE_PATH=
/SEARCH_SUBFOLDERS=TRUE
! /SUFFIX=
! /SET_PROMPT=File_Open
/ON_FILE_NOT_FOUND=FAIL
! /FILE_TYPES_ON_PROMPT=
;

File_Open
/FILE_NAME=::FOLDER&*_SLSR_*_pose_filt_0.c3d
! /FILE_PATH=
/SEARCH_SUBFOLDERS=TRUE
! /SUFFIX=
! /SET_PROMPT=File_Open
/ON_FILE_NOT_FOUND=FAIL
