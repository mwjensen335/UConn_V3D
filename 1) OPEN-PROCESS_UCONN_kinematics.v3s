Assign_Tags_To_Files
 /MOTION_FILE_NAMES=*_SLSR_*.c3d
! /QUERY=
 /TAGS=SLS_R
;

Assign_Tags_To_Files
 /MOTION_FILE_NAMES=*_SLSL_*.c3d
! /QUERY=
 /TAGS=SLS_L
;

Assign_Tags_To_Files
/MOTION_FILE_NAMES=*DLS*.c3d
/QUERY= 
/TAGS=DLS
;

Assign_Tags_To_Files
/MOTION_FILE_NAMES=*jump-landing*.c3d
/QUERY= 
/TAGS=JL
;

Assign_Tags_To_Files
/MOTION_FILE_NAMES=*JL*.c3d
/QUERY= 
/TAGS=JL
;

Assign_Tags_To_Files
! /MOTION_FILE_NAMES=
/TAGS= Right
;

Assign_Tags_To_Files
! /MOTION_FILE_NAMES=
/TAGS= Left
;

!Start PROCESSING ***************************

Set_Use_Processed_Analog
/USE_PROCESSED=TRUE
;

Set_Use_Processed_Targets
/USE_PROCESSED=TRUE
;

Select_Active_File
 /FILE_NAME=ALL_FILES
! /QUERY=
! /SUBJECT_TAGS=NO_SUBJECT
;

! ---------------------------------------------------------------------- LINK-MODEL-BASED CALCULATIONS
! Make all files active
Select_Active_File
/FILE_NAME=ALL_FILES
!/QUERY= 
;

! Need to build virtual lab since ~2024-10-07
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=VLB_Distal_Radius
/METRIC_VALUE=0.01
! /SUBJECT=
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=VLB_Proximal_Radius
/METRIC_VALUE=0.01
! /SUBJECT=
