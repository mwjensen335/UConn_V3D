! Clear the workspace
File_New
;

! Set the root directory
Set_Pipeline_Parameter_To_Folder_Path
/PARAMETER_NAME=ROOTFOLDER
! /PARAMETER_VALUE= 
! /FROM_MOTION_FILE_IN_WORKSPACE=
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_APPEND=
/SET_PROMPT=Select the _c3d directory.
/ALPHABETIZE=TRUE
;

! ---------------------------------------------------------------------- LOOP TO BUILD SUBJECT WORKSPACES
! Get list of all folders (& subfolders) from the root directory that contain .c3d files
Set_Pipeline_Parameter_To_List_Of_Files
/PARAMETER_NAME=SUBFOLDERS
/FOLDER=::ROOTFOLDER
/SEARCH_SUBFOLDERS=TRUE
/FILE_MASK=*.c3d
! /ALPHABETIZE=TRUE
/RETURN_FOLDER_NAMES=TRUE
;

! Set the previous subject to be empty
Set_Pipeline_Parameter
/PARAMETER_NAME=PREV_SUBJECT
/PARAMETER_VALUE=EMPTY
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
! /MULTI_PASS=FALSE
;

! Set an empty subject list
Set_Pipeline_Parameter
/PARAMETER_NAME=SUBJECT_LIST
/PARAMETER_VALUE=EMPTY
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
! /MULTI_PASS=FALSE
;

! Loop through all subfolders containing .c3d files from the root folder
For_Each
/ITERATION_PARAMETER_NAME=SUBFOLDER
! /ITERATION_PARAMETER_COUNT_NAME=COUNT
/ITEMS=::SUBFOLDERS
;

! Remove the root folder from the path
Set_Pipeline_Parameter
/PARAMETER_NAME=FULL_TRIAL_PATH
/PARAMETER_VALUE=::SUBFOLDER
/PARAMETER_VALUE_SEARCH_FOR=::ROOTFOLDER
/PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
! /MULTI_PASS=FALSE
;

! Extract the subject name from the subject-level folder
Set_Pipeline_Parameter_From_Expression
/PARAMETER_NAME=SUBJECT_NAME
/EXPRESSION=STRING_LEFT("&::FULL_TRIAL_PATH&",STRING_FIND("&::FULL_TRIAL_PATH&",\,0))
/AS_INTEGER=FALSE
;

! Test if the subject name is the same as the previous subject name
Conditional_Statement
/ITERATION_PARAMETER_NAME= NEW_SUBJECT
/EXPRESSION= "&::PREV_SUBJECT&" <> "&::SUBJECT_NAME&"
/AS_INTEGER=FALSE
;

! Test if the subject list is not empty
Conditional_Statement
/ITERATION_PARAMETER_NAME= NON_EMPTY_LIST
/EXPRESSION= "&::SUBJECT_LIST&" <> "EMPTY"
/AS_INTEGER=FALSE
;

! Add the subject name to the subject list
Set_Pipeline_Parameter
/PARAMETER_NAME=SUBJECT_LIST
/PARAMETER_VALUE= ::SUBJECT_LIST&+&::SUBJECT_NAME
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
! /MULTI_PASS=FALSE
;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME= NON_EMPTY_LIST
;

! Test if the subject list is empty
Conditional_Statement
/ITERATION_PARAMETER_NAME= EMPTY_LIST
/EXPRESSION= "&::SUBJECT_LIST&" == EMPTY
/AS_INTEGER=FALSE
;

! Add the subject name to the subject list (this will be the first subject name entry)
Set_Pipeline_Parameter
/PARAMETER_NAME=SUBJECT_LIST
/PARAMETER_VALUE= ::SUBJECT_NAME
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
! /MULTI_PASS=FALSE
;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME= EMPTY_LIST
;

! Set the current subject name to be the new previous subject
Set_Pipeline_Parameter
/PARAMETER_NAME=PREV_SUBJECT
/PARAMETER_VALUE=::SUBJECT_NAME
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
! /MULTI_PASS=FALSE
;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME= NEW_SUBJECT
;

End_For_Each
/ITERATION_PARAMETER_NAME=SUBFOLDER
;

! Iterate through the subjects in the subject list
For_Each
/ITERATION_PARAMETER_NAME=SUBJECT
! /ITERATION_PARAMETER_COUNT_NAME=COUNT
/ITEMS=::SUBJECT_LIST
;

! Set a variable referring to the subject's folder
Set_Pipeline_Parameter
/PARAMETER_NAME=SUBJECT_FOLDER
/PARAMETER_VALUE=::ROOTFOLDER&::SUBJECT&\
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
! /MULTI_PASS=FALSE
;

! Opening the subject's .c3d files
File_Open
/FILE_NAME=::SUBJECT_FOLDER&*filt*.c3d
! /FILE_PATH=
/SEARCH_SUBFOLDERS=TRUE
! /SUFFIX=
! /SET_PROMPT=File_Open
! /ON_FILE_NOT_FOUND=PROMPT
! /FILE_TYPES_ON_PROMPT=
;

! Add a WALK tag to all files with "Walk" in the filename
Assign_Tags_To_Files
/MOTION_FILE_NAMES=*Walk*
! /QUERY=
/TAGS= WALK
;

! ---------------------------------------------------------------------- CREATING KINEMATIC GAIT EVENTS
! Make all WALK files active
Select_Active_File
/FILE_NAME= ALL_FILES
/QUERY= WALK
;

! Put R_HEEL landmark in pelvis coordinate system
Compute_Model_Based_Data
/RESULT_NAME=R_HEEL_WRT_RPV
/FUNCTION=TARGET_PATH
/SEGMENT=R_HEEL
/REFERENCE_SEGMENT=RPV
/RESOLUTION_COORDINATE_SYSTEM=RPV
! /USE_CARDAN_SEQUENCE=FALSE
! /NORMALIZATION=FALSE
! /NORMALIZATION_METHOD=
! /NORMALIZATION_METRIC=
! /NEGATEX=FALSE
! /NEGATEY=FALSE
! /NEGATEZ=FALSE
! /AXIS1=X
! /AXIS2=Y
! /AXIS3=Z
! /TREADMILL_DATA=FALSE
! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
! /TREADMILL_SPEED=0.0
;

! Put L_HEEL landmark in pelvis coordinate system
Compute_Model_Based_Data
/RESULT_NAME=L_HEEL_WRT_RPV
/FUNCTION=TARGET_PATH
/SEGMENT=L_HEEL
/REFERENCE_SEGMENT=RPV
/RESOLUTION_COORDINATE_SYSTEM=RPV
! /USE_CARDAN_SEQUENCE=FALSE
! /NORMALIZATION=FALSE
! /NORMALIZATION_METHOD=
! /NORMALIZATION_METRIC=
! /NEGATEX=FALSE
! /NEGATEY=FALSE
! /NEGATEZ=FALSE
! /AXIS1=X
! /AXIS2=Y
! /AXIS3=Z
! /TREADMILL_DATA=FALSE
! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
! /TREADMILL_SPEED=0.0
;

! Create RHS (right heelstrike) event at maximum of distance from R_HEEL to pelvis in Y-direction of pelvis coordinate system
Event_Maximum
/RESULT_EVENT_NAME=RHS
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=R_HEEL_WRT_RPV
/SIGNAL_COMPONENTS=Y
! /FRAME_OFFSET=0
! /TIME_OFFSET=
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /EVENT_INSTANCE=0
/FRAME_WINDOW=20
! /THRESHOLD=
;

! Create LHS (left heelstrike) event at maximum of distance from L_HEEL to pelvis in Y-direction of pelvis coordinate system
Event_Maximum
/RESULT_EVENT_NAME=LHS
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=L_HEEL_WRT_RPV
/SIGNAL_COMPONENTS=Y
! /FRAME_OFFSET=0
! /TIME_OFFSET=
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /EVENT_INSTANCE=0
/FRAME_WINDOW=20
! /THRESHOLD=
;

! highlight RHS, LHS events on plots with colored vertical lines
Highlight_Event_Label
/EVENT_LABEL=LHS+RHS
/REMOVE_EXISTING_HIGHLIGHTS=TRUE
;

! ---------------------------------------------------------------------- LINK-MODEL-BASED CALCULATIONS
! Make all WALK files active
Select_Active_File
/FILE_NAME=ALL_FILES
/QUERY= WALK
;

