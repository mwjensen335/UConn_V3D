
!************************ RIGHT LEG PROCESSING *****************************

! Create signal tag for leg
Set_Pipeline_Parameter
/PARAMETER_NAME= LEG
/PARAMETER_VALUE= R
;

! Select active files to be a particular leg and trial type
Select_Active_File
/FILE_NAME= Right
/QUERY= SLS_R + DLS + JL
;

!------------------------------------------------------------------
! Create loop for all SQUAT trial types
!------------------------------------------------------------------

For_Each
/ITERATION_PARAMETER_NAME= TRIAL_TYPE
/ITEMS= SLS_R + DLS
;

! Select active files to be a particular trial type
Select_Active_File
/FILE_NAME= Right
/QUERY= ::TRIAL_TYPE
;

! Ankle Rotations____________________________

Global_Normalized_Signal_Mean
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_NAMES=RIGHT_ANKLE_ANGLE
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_COMPONENTS=X
! /START_LABEL=
! /END_LABEL=
/EVENT_SEQUENCE=RON+ROFF
!/EXCLUDE_EVENTS=
/RESULT_NAME=::TRIAL_TYPE&_&::LEG&_Ankle Rotations_X_AVG
! /RESULT_FOLDER=ORIGINAL
! /NORMALIZE_POINTS=101
/CREATE_STANDARD_DEVIATION=TRUE
! /CALCULATE_PER_FILE=FALSE
;

Global_Normalized_Signal_Mean
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_NAMES=RIGHT_ANKLE_ANGLE
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_COMPONENTS=Y
! /START_LABEL=
! /END_LABEL=
/EVENT_SEQUENCE=RON+ROFF
!/EXCLUDE_EVENTS= 
/RESULT_NAME=::TRIAL_TYPE&_&::LEG&_Ankle Rotations_Y_AVG
! /RESULT_FOLDER=ORIGINAL
! /NORMALIZE_POINTS=101
/CREATE_STANDARD_DEVIATION=TRUE
! /CALCULATE_PER_FILE=FALSE
;

Global_Normalized_Signal_Mean
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_NAMES=RIGHT_ANKLE_ANGLE
! /SIGNAL_FOLDER=ORIGINAL
