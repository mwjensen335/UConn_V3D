! Set_Segment_Auto_Assign_Force
! ! /CALIBRATION_FILE=
! /SEGMENT_NAMES=RTO+LTO+RFT+LFT
! /USE_FOR_AUTO_ASSIGN=FALSE+FALSE+TRUE+TRUE
! ;

Set_Segment_Properties
/CALIBRATION_FILE=*.c3d
/SEGMENT_NAME=RTX
/KINEMATIC_ONLY=TRUE
! /MASS=
