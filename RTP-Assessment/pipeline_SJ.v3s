!General parameters (same for all tasks)
!============================================
 
	Select_Active_File
	/FILE_NAME=Static
	;

	Metric_Mean
	/RESULT_METRIC_FOLDER=STATIC
	/RESULT_METRIC_NAME=_mean
	/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
	/SIGNAL_TYPES=LINK_MODEL_BASED
	/SIGNAL_FOLDER=ORIGINAL
	/SIGNAL_NAMES=CenterOfMass
	!/SIGNAL_COMPONENTS=
	/COMPONENT_SEQUENCE=ALL
	/EVENT_SEQUENCE=
	/EXCLUDE_EVENTS=
	! /SEQUENCE_PERCENT_START=0
	! /SEQUENCE_PERCENT_END=100
	/GENERATE_MEAN_AND_STDDEV=TRUE
	! /APPEND_TO_EXISTING_VALUES=FALSE
	;
 

Select_Active_File
/FILE_NAME=ALL_FILES
! /QUERY=
;

! Foot normalization -----------------
! if Marker-based:
! 	if field = false > use L/RMF -> solution A
!	else use 'normalized foot segment' -> solution B

! if Markerless (foot is always normalizes by Theia model):
! 	if Static exists and field = true
!		> works as solution A
! 	elseif Static exists and field = false
!		> works as solution A
! 	else Static does not exist
!		> works as solution A

 
	Compute_Model_Based_Data
	/RESULT_NAME=Left Ankle Angles
	/FUNCTION=JOINT_ANGLE
	/SEGMENT=LMF
	/REFERENCE_SEGMENT=LSK
	/RESOLUTION_COORDINATE_SYSTEM=
	! /USE_CARDAN_SEQUENCE=FALSE
	! /NORMALIZATION=FALSE
	! /NORMALIZATION_METHOD=
	! /NORMALIZATION_METRIC=
	! /NEGATEX=FALSE
	/NEGATEY=TRUE
	/NEGATEZ=TRUE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	;

	Compute_Model_Based_Data
	/RESULT_NAME=Left Foot Pitch Angles
	/FUNCTION=JOINT_ANGLE
	/SEGMENT=LMF
	/REFERENCE_SEGMENT=Virtual Lab
	/RESOLUTION_COORDINATE_SYSTEM=
	! /USE_CARDAN_SEQUENCE=FALSE
	! /NORMALIZATION=FALSE
	! /NORMALIZATION_METHOD=
	! /NORMALIZATION_METRIC=
	! /NEGATEX=FALSE
	! /NEGATEY=FALSE
	! /NEGATEZ=FALSE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	! /TREADMILL_DATA=FALSE
	! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
	! /TREADMILL_SPEEED=0.0
	;

	Compute_Model_Based_Data
	/RESULT_NAME=Left Foot Progression
	/FUNCTION=JOINT_ANGLE
	/SEGMENT=LMF
	/REFERENCE_SEGMENT=RPV
	/RESOLUTION_COORDINATE_SYSTEM=
	! /USE_CARDAN_SEQUENCE=FALSE
	! /NORMALIZATION=FALSE
	! /NORMALIZATION_METHOD=
	! /NORMALIZATION_METRIC=
	! /NEGATEX=FALSE
	! /NEGATEY=FALSE
	/NEGATEZ=TRUE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	! /TREADMILL_DATA=FALSE
	! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
	! /TREADMILL_SPEEED=0.0
	;

	Compute_Model_Based_Data
	/RESULT_NAME=Right Ankle Angles
	/FUNCTION=JOINT_ANGLE
	/SEGMENT=RMF
	/REFERENCE_SEGMENT=RSK
	/RESOLUTION_COORDINATE_SYSTEM=
	! /USE_CARDAN_SEQUENCE=FALSE
	! /NORMALIZATION=FALSE
	! /NORMALIZATION_METHOD=
	! /NORMALIZATION_METRIC=
	! /NEGATEX=FALSE
	! /NEGATEY=FALSE
	! /NEGATEZ=FALSE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	;

	Compute_Model_Based_Data
	/RESULT_NAME=Right Foot Pitch Angles
	/FUNCTION=JOINT_ANGLE
	/SEGMENT=RMF
	/REFERENCE_SEGMENT=Virtual Lab
	/RESOLUTION_COORDINATE_SYSTEM=
	! /USE_CARDAN_SEQUENCE=FALSE
	! /NORMALIZATION=FALSE
	! /NORMALIZATION_METHOD=
	! /NORMALIZATION_METRIC=
	! /NEGATEX=FALSE
	! /NEGATEY=FALSE
	! /NEGATEZ=FALSE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	! /TREADMILL_DATA=FALSE
	! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
	! /TREADMILL_SPEEED=0.0
	;

	Compute_Model_Based_Data
	/RESULT_NAME=Right Foot Progression
	/FUNCTION=JOINT_ANGLE
	/SEGMENT=RMF
	/REFERENCE_SEGMENT=RPV
	/RESOLUTION_COORDINATE_SYSTEM=
	! /USE_CARDAN_SEQUENCE=FALSE
	! /NORMALIZATION=FALSE
	! /NORMALIZATION_METHOD=
	! /NORMALIZATION_METRIC=
	! /NEGATEX=FALSE
	! /NEGATEY=FALSE
	! /NEGATEZ=FALSE
	! /AXIS1=X
	! /AXIS2=Y
	! /AXIS3=Z
	! /TREADMILL_DATA=FALSE
	! /TREADMILL_DIRECTION=UNIT_VECTOR(0,1,0)
	! /TREADMILL_SPEEED=0.0
	;
 

! Velocities
First_Derivative
/SIGNAL_TYPES=LINK_MODEL_BASED
/SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=CenterOfMass+PelvisCGPos+Left Ankle Angles+Left Hip Angles+Left Knee Angles+Right Ankle Angles+Right Hip Angles+Right Knee Angles
/RESULT_TYPES=DERIVED
! /RESULT_FOLDERS=PROCESSED
/RESULT_NAME=_vel
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
;

!remove gimbal lock from shoulder angles
Evaluate_Expression
/EXPRESSION=resolve_discontinuity(LINK_MODEL_BASED::ORIGINAL::Left Shoulder Angles,360)
/RESULT_TYPES=LINK_MODEL_BASED
! /RESULT_FOLDERS=PROCESSED
/RESULT_NAME=Left Shoulder Angles
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Evaluate_Expression
/EXPRESSION=resolve_discontinuity(LINK_MODEL_BASED::ORIGINAL::Right Shoulder Angles,360)
/RESULT_TYPES=LINK_MODEL_BASED
! /RESULT_FOLDERS=PROCESSED
/RESULT_NAME=Right Shoulder Angles
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Set_Pipeline_Parameter
/PARAMETER_NAME=left_trial_exists
/PARAMETER_VALUE=false
;

Set_Pipeline_Parameter
/PARAMETER_NAME=right_trial_exists
/PARAMETER_VALUE=false
;

 


 

!=======================================
Select_Active_File
/FILE_NAME=SJ 
! /QUERY=
;

! Zeroing force plates. Default is first 10 frames.
Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=((0 <> 10) &::AMP& ( = 1))
! /AS_INTEGER=TRUE
;

	Modify_Force_Platform_Parameters
	/FP_ZERO=0+10 
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

! Halt script if event mode is set to 'Force Plates' but force data do not exist
 
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(Data_Exists(FORCE::ORIGINAL::FP1) <> 1)
	! /AS_INTEGER=TRUE
	;

		Pipeline_Breakpoint
		/PAUSE_MESSAGE=Event mode is set to 'Force Plates' but no force data has been found. Halt the script and set event mode to 'No Force Plate (Automatic)' or 'Manual'.
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

Select_Active_File
/FILE_NAME=SJ 
! /QUERY=
;

 
	! Automatic_Gait_Events
	! ! /FRAME_WINDOW=8
	! /USE_TPR=FALSE
	! ;
 

Event_Explicit
/EVENT_NAME=BOF
/FRAME=3
! /TIME=
;

Event_Explicit
/EVENT_NAME=EOF
/FRAME=EOF
! /TIME=
;

! Decide side and create corresponding tags
Set_Pipeline_Parameter_To_List_Of_Tagged_Files
/PARAMETER_NAME=sc_files
/TAG_NAME=SJ 
! /GET_CURRENT_SELECTED_FILES=false
! /USE_SHORT_FILENAMES=false
;

For_Each
/ITERATION_PARAMETER_NAME=filename
/ITEMS=::sc_files
;

	Select_Active_File
	/FILE_NAME=::filename
	! /QUERY=
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(Data_Exists(LINK_MODEL_BASED::ORIGINAL::Right GRF) &::AMP& Data_Exists(LINK_MODEL_BASED::ORIGINAL::Left GRF))
	! /AS_INTEGER=TRUE
	;

		Assign_Tags_To_Files
		/MOTION_FILE_NAMES=::filename
		! /QUERY=
		/TAGS=SJ_B
		; 

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;
	
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(Data_Exists(LINK_MODEL_BASED::ORIGINAL::Right GRF) &::AMP& (Data_Exists(LINK_MODEL_BASED::ORIGINAL::Left GRF) <> 1))
	! /AS_INTEGER=TRUE
	;

		Assign_Tags_To_Files
		/MOTION_FILE_NAMES=::filename
		! /QUERY=
		/TAGS=SJ_R 
		; 

		Set_Pipeline_Parameter
		/PARAMETER_NAME=right_trial_exists
		/PARAMETER_VALUE=true
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;
	
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(Data_Exists(LINK_MODEL_BASED::ORIGINAL::Left GRF) &::AMP& (Data_Exists(LINK_MODEL_BASED::ORIGINAL::Right GRF) <> 1))
	! /AS_INTEGER=TRUE
	;

		Assign_Tags_To_Files
		/MOTION_FILE_NAMES=::filename
		! /QUERY=
		/TAGS=SJ_L
		; 

		Set_Pipeline_Parameter
		/PARAMETER_NAME=left_trial_exists
		/PARAMETER_VALUE=true
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

End_For_Each
/ITERATION_PARAMETER_NAME=filename
;

Select_Active_File
/FILE_NAME=SJ_L+SJ_B
! /QUERY=
;

! Find flight phase (we assume that foot dist end max vertical height happens during flight phase)
Event_Global_Maximum
/RESULT_EVENT_NAME=Left_max_toe_height
/SIGNAL_TYPES=KINETIC_KINEMATIC
/SIGNAL_FOLDER=LFT
/SIGNAL_NAMES=DistEndPos
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
! /EVENT_SEQUENCE=LOFF+EOF
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /THRESHOLD=
;

! Search for peak landing force between inflight and EOF events
Event_Global_Maximum
/RESULT_EVENT_NAME=Left_Peak_landing_force
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=Left GRF
/SIGNAL_COMPONENTS=Z
! /FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=Left_max_toe_height+EOF
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
! /THRESHOLD=
;

! Create a new Left_Peak_landing_force event and add 1 frame offset (this event will only be used in the range when deleting extra LON events)
Event_Copy
/EVENT_NAME=Left_Peak_landing_force
/NEW_EVENT_NAME=Left_Peak_landing_force_offset
! /EVENT_INSTANCE=0
! /EVENT_INSTANCE_AS_LIST=FALSE
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
/FRAME_OFFSET=1
! /TIME_OFFSET=
! /PERCENT_OFFSET=
;

Event_Threshold
/RESULT_EVENT_NAME=LON
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=Left GRF
/SIGNAL_COMPONENTS=Z
/FRAME_OFFSET=0
! /TIME_OFFSET=
/EVENT_SEQUENCE=BOF+Left_Peak_landing_force
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=-1
/THRESHOLD=0.05
/ON_ASCENT=TRUE
/ON_DESCENT=FALSE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

Event_Threshold
/RESULT_EVENT_NAME=LOFF
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=Left GRF
/SIGNAL_COMPONENTS=Z
/FRAME_OFFSET=1
! /TIME_OFFSET=
/EVENT_SEQUENCE=BOF+LON
! /EXCLUDE_EVENTS=
! /EVENT_SEQUENCE_INSTANCE=0
! /EVENT_SUBSEQUENCE=
! /SUBSEQUENCE_EXCLUDE_EVENTS=
! /EVENT_SUBSEQUENCE_INSTANCE=0
/EVENT_INSTANCE=-1
/THRESHOLD=0.05
/ON_ASCENT=FALSE
/ON_DESCENT=TRUE
! /FRAME_WINDOW=8
! /ENSURE_FRAMES_BEFORE=FALSE
! /ENSURE_FRAMES_AFTER=FALSE
;

! Delete false ON events between peak landing force and EOF
Event_Delete
/EVENT_NAME=LON
/EVENT_SEQUENCE=Left_Peak_landing_force_offset+EOF
! /EXCLUDE_EVENTS=
! /EVENT_INSTANCE=
! /TIME=
;

! Delete false OFF events between ON and EOF
Event_Delete
/EVENT_NAME=LOFF
/EVENT_SEQUENCE=LON+EOF
! /EXCLUDE_EVENTS=
! /EVENT_INSTANCE=
! /TIME=
;

Event_Copy
/EVENT_NAME=LON
/NEW_EVENT_NAME=TouchDown_L
/EVENT_INSTANCE=1
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
/FRAME_OFFSET=0
! /TIME_OFFSET=
! /PERCENT_OFFSET=
;

Event_Copy
/EVENT_NAME=LOFF
/NEW_EVENT_NAME=TakeOff_L
/EVENT_INSTANCE=1
! /RANGE_INSTANCE=0
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /START_AT_EVENT=
! /END_AT_EVENT=
/FRAME_OFFSET=0
! /TIME_OFFSET=
! /PERCENT_OFFSET=
;

Event_Threshold
/RESULT_EVENT_NAME=PlotStart_L
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=PROCESSED
/SIGNAL_NAMES=PelvisCGPos_vel
/SIGNAL_COMPONENTS=Z
