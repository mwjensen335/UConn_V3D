!Prepare export for web report
Select_Active_File
/FILE_NAME=ALL_FILES
! /QUERY=
;

Evaluate_Expression
/EXPRESSION=PARAMETERS::POINT::RATE
/RESULT_TYPES=METRIC
! /RESULT_FOLDERS=PROCESSED
