!Find out which maker set is used
Conditional_Statement
/ITERATION_PARAMETER_NAME=sport
/EXPRESSION=(Data_Exists(TARGET::ORIGINAL::LAnkleOut) = 1)
! /AS_INTEGER=TRUE
;

	Set_Pipeline_Parameter
	/PARAMETER_NAME=markerset_used
	/PARAMETER_VALUE=sports
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=sport
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=meyer_marker_set
/EXPRESSION=Data_Exists(TARGET::ORIGINAL::LDIHE)
! /AS_INTEGER=TRUE
;

	Set_Pipeline_Parameter
	/PARAMETER_NAME=markerset_used
	/PARAMETER_VALUE=meyer
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=meyer_marker_set
