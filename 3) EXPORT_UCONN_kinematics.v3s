Set_Pipeline_Parameter_To_Folder_Path
/PARAMETER_NAME= FOLDER3
/PARAMETER_VALUE= R:\nrg02003\LabWork\CRISP 2.0\Data_To Process
;

Prompt_For_Pipeline_Parameter_Value
/PIPELINE_PARAMETER_NAME=SUBJECT
/PROMPT= Subject No.
/DATATYPE= int
/DEFAULT_VALUE=
;

! Create loop for all trial types
For_Each
/ITERATION_PARAMETER_NAME= TRIAL_TYPE
/ITEMS= DLS + SLS_L + SLS_R + JL
;

!-------------------------------------------
! KINEMATICS
!-------------------------------------------

Export_Data_To_Ascii_File
/FILE_NAME=::FOLDER3&Subject &::SUBJECT&_&::TRIAL_TYPE&_L_Kinematics.txt
/SIGNAL_TYPES=P2D
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=::TRIAL_TYPE&_L_ANKLE ROTATIONS_X_AVG+::TRIAL_TYPE&_L_ANKLE ROTATIONS_Y_AVG+::TRIAL_TYPE&_L_ANKLE ROTATIONS_Z_AVG+::TRIAL_TYPE&_L_KNEE ROTATIONS_X_AVG+::TRIAL_TYPE&_L_KNEE ROTATIONS_Y_AVG+::TRIAL_TYPE&_L_KNEE ROTATIONS_Z_AVG+::TRIAL_TYPE&_L_HIP ROTATIONS_X_AVG+::TRIAL_TYPE&_L_HIP ROTATIONS_Y_AVG+::TRIAL_TYPE&_L_HIP ROTATIONS_Z_AVG+::TRIAL_TYPE&_L_TRUNK ROTATIONS_X_AVG+::TRIAL_TYPE&_L_TRUNK ROTATIONS_Y_AVG+::TRIAL_TYPE&_L_TRUNK ROTATIONS_Z_AVG
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=Y
! /SIGNAL_PRECISION=
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /USE_POINT_RATE=FALSE
! /NORMALIZE_DATA=FALSE
! /NORMALIZE_POINTS=101
! /EXPORT_MEAN_AND_STD_DEV=FALSE
! /EXPORT_MEAN_AND_STD_DEV_FOR_METRIC=FALSE
! /USE_P2D_FORMAT=FALSE
! /USE_XML_FORMAT=FALSE
! /USE_JSON_FORMAT=FALSE
! /USE_SHORT_FILENAME=FALSE
! /INCLUDE_TAGS_FOR_XML=FALSE
! /EXPORT_EMPTY_SIGNALS=FALSE
! /EXPORT_WITHOUT_HEADER=FALSE
! /EXPORT_COMPONENT_AS_TEXT=FALSE
! /EXPORT_NAN=FALSE
! /CREATE_FOLDER_PATH=TRUE
! /USE_SCIENTIFIC_NOTATION=FALSE
;

Export_Data_To_Ascii_File
/FILE_NAME=::FOLDER3&Subject &::SUBJECT&_&::TRIAL_TYPE&_R_Kinematics.txt
/SIGNAL_TYPES=P2D
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=::TRIAL_TYPE&_R_ANKLE ROTATIONS_X_AVG+::TRIAL_TYPE&_R_ANKLE ROTATIONS_Y_AVG+::TRIAL_TYPE&_R_ANKLE ROTATIONS_Z_AVG+::TRIAL_TYPE&_R_KNEE ROTATIONS_X_AVG+::TRIAL_TYPE&_R_KNEE ROTATIONS_Y_AVG+::TRIAL_TYPE&_R_KNEE ROTATIONS_Z_AVG+::TRIAL_TYPE&_R_HIP ROTATIONS_X_AVG+::TRIAL_TYPE&_R_HIP ROTATIONS_Y_AVG+::TRIAL_TYPE&_R_HIP ROTATIONS_Z_AVG+::TRIAL_TYPE&_R_TRUNK ROTATIONS_X_AVG+::TRIAL_TYPE&_R_TRUNK ROTATIONS_Y_AVG+::TRIAL_TYPE&_R_TRUNK ROTATIONS_Z_AVG
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=Y
! /SIGNAL_PRECISION=
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /USE_POINT_RATE=FALSE
! /NORMALIZE_DATA=FALSE
! /NORMALIZE_POINTS=101
! /EXPORT_MEAN_AND_STD_DEV=FALSE
! /EXPORT_MEAN_AND_STD_DEV_FOR_METRIC=FALSE
! /USE_P2D_FORMAT=FALSE
! /USE_XML_FORMAT=FALSE
! /USE_JSON_FORMAT=FALSE
! /USE_SHORT_FILENAME=FALSE
