/SEQUENCE_PERCENT_END=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
! /CREATE_GLOBAL_MAXIMUM=FALSE
! /CREATE_TRIAL_MAXIMUM=FALSE
;

! Get min (right) value of ML position of knee vs ankle
Metric_Minimum
/RESULT_METRIC_FOLDER=LESS_VALUES
/RESULT_METRIC_NAME=RIGHT_KNEE_VS_ANKLE_DIFF_MAX
