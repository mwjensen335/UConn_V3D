! Get difference in medial-lateral position of knee vs ankle along Pelvis x-axis
Evaluate_Expression
/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::RIGHT_KNEE_WRT_RPV::X - LINK_MODEL_BASED::ORIGINAL::RIGHT_ANKLE_WRT_RPV::X
/RESULT_NAME=RIGHT_KNEE_VS_ANKLE_DIFF
/RESULT_TYPE=DERIVED
/RESULT_FOLDER=PROCESSED
;

! Get difference in medial-lateral position of knee vs ankle along Pelvis x-axis
Evaluate_Expression
/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::LEFT_KNEE_WRT_RPV::X- LINK_MODEL_BASED::ORIGINAL::LEFT_ANKLE_WRT_RPV::X
/RESULT_NAME=LEFT_KNEE_VS_ANKLE_DIFF
/RESULT_TYPE=DERIVED
/RESULT_FOLDER=PROCESSED
;

! Get difference in medial-lateral position of knee vs distal foot along Pelvis x-axis (experimental)
Evaluate_Expression
/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::RIGHT_KNEE_WRT_RPV::X - LINK_MODEL_BASED::ORIGINAL::RIGHT_FOOT_WRT_RPV::X
/RESULT_NAME=RIGHT_KNEE_VS_FOOT_DIFF
/RESULT_TYPE=DERIVED
/RESULT_FOLDER=PROCESSED
;

! Get difference in medial-lateral position of knee vs distal foot along Pelvis x-axis (experimental)
Evaluate_Expression
/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::LEFT_KNEE_WRT_RPV::X- LINK_MODEL_BASED::ORIGINAL::LEFT_FOOT_WRT_RPV::X
/RESULT_NAME=LEFT_KNEE_VS_FOOT_DIFF
/RESULT_TYPE=DERIVED
/RESULT_FOLDER=PROCESSED
;

! Get max value (left) of ML position of knee vs ankle
Metric_Maximum
/RESULT_METRIC_FOLDER=LESS_VALUES
/RESULT_METRIC_NAME=LEFT_KNEE_VS_ANKLE_DIFF_MAX
