! ------------------------------------------------
!  Prompt the user for the desired image from a 
!   list of files in the workspace
! ------------------------------------------------

Set_Pipeline_Parameter_To_List_Of_Tagged_Files
/PARAMETER_NAME=FILES
/TAG_NAME=ALL_FILES
/GET_CURRENT_SELECTED_FILES=false
/USE_SHORT_FILENAMES=TRUE
;

Prompt_For_Pipeline_Parameter_Value
/PIPELINE_PARAMETER_NAME=SELECTED_FILE
/PROMPT=Select image file
! /DATA_TYPE=
/DEFAULT_VALUE=::FILES
;

Select_Active_File
/FILE_NAME=*&::SELECTED_FILE
! /QUERY=
;

Set_View_Options
! /VIEW_FORCE_PLATFORMS=
! /VIEW_GRF_BUTTERFLY=
! /VIEW_GRF=
! /VIEW_GRF_COFP=
! /VIEW_FREEMOMENT_AT_COP=
! /VIEW_CUSTOM_FORCES=
! /VIEW_FORCE_STRUCTURE_VECTOR=
! /VIEW_FORCE_ASSIGNMENT=
/VIEW_LAB=TRUE
/VIEW_LAB_AXES=FALSE
! /VIEW_LAB_AXES_MODEL_BUILDER=
! /FLOOR_WIDTH=
! /FLOOR_LENGTH=
! /FLOOR_CENTERX=
! /FLOOR_CENTERY=
! /FLOOR_CENTERZ=
! /FLOOR_ROTX=
! /FLOOR_ROTY=
! /FLOOR_ROTZ=
! /VIEW_FOOTPRINTS=
/VIEW_TARGETS=FALSE
! /VIEW_TARGETS_WITH_RESIDUAL_COLORMAP=
/VIEW_LANDMARKS=FALSE
! /VIEW_JOINTS=
! /VIEW_LOCAL_TARGETS=
! /VIEW_ROTATIONS=
! /VIEW_ROTATION_LABELS=
! /VIEW_MODEL_COM=
! /VIEW_MUSCLES=
! /VIEW_MUSCLES_AS_LINES=
! /VIEW_SEGMENTS=
! /VIEW_KINEMATIC_ONLY_SEGMENTS=
! /VIEW_SEGMENT_COLORIZATION=
! /VIEW_SEGMENT_GEOMETRY=
! /VIEW_SEGMENT_LINES=
! /VIEW_KINEMATIC_SEGMENT_LINES=
/VIEW_SCS_AXES=FALSE
! /VIEW_SCS_AXES_COM=
! /VIEW_COLORED_BACKGROUND=
/SET_BACKGROUND_COLOR=Black
! /SET_FLOOR_COLOR=NO_CHANGE
! /SET_FP_COLOR=NO_CHANGE
! /VIEW_TARGET_TRAIL=
! /VIEW_SEGMENT_TRAIL=
! /VIEW_LANDMARK_TRAIL=
! /VIEW_COM_TRAIL=
! /VIEW_ROTATION_TRAIL=
! /VIEW_TRAIL_ALL_FRAMES=
! /VIEW_TRAIL_DRAW_AHEAD=
! /VIEW_TRAIL_DRAW_BEHIND=
! /UPDATE_REGISTRY=FALSE
;

Set_Pipeline_Parameter
/PARAMETER_NAME=SELECTED_FILE_NUMBER
/PARAMETER_VALUE=::SELECTED_FILE
/PARAMETER_VALUE_SEARCH_FOR=.c3d
/PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
;

! ------------------------------------------------
        ! Set camera perspective (Sagittal)
        ! ------------------------------------------------

Set_Camera_Perspective
! /TRACK_CAMERA_USING_SEGMENT=FALSE
! /TRACK_CAMERA_USING_SEGMENT_COM=FALSE
! /SEGMENT=
/CAMERA_X_CENTER=0.187
/CAMERA_Y_CENTER=0.472
/CAMERA_Z_CENTER=-0.852
/CAMERA_ZOOM=2.290
/CAMERA_PAN=91.325
/CAMERA_TILT=-9.050
;

Export_3D_Animation_To_Image
/FILE_NAME=*&::SELECTED_FILE
/IMAGE_FILE_NAME=R:\nrg02003\LabWork\Theia Data\ISM Testing\AAU Spring 2025\AAU_c3d\Group 1\Jump-landing\00001\&::SELECTED_FILE_NUMBER&_SagIC.png
