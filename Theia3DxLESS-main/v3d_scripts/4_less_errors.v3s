Select_Active_File
/FILE_NAME=ALL_FILES
! /QUERY=
! /SUBJECT_TAGS=NO_SUBJECT
;

! Knee Flexion at Initial Contact (Padua Item 1)
Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::LEFT_KNEE_FLX_IC < 30)*1
/RESULT_NAME=LEFT_KNEE_FLX_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::RIGHT_KNEE_FLX_IC < 30)*1
/RESULT_NAME=RIGHT_KNEE_FLX_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Hip Flexion at Initial Contact (Padua Item 2)
Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::LEFT_HIP_FLX_IC < 30)*1
/RESULT_NAME=LEFT_HIP_FLX_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::RIGHT_HIP_FLX_IC < 30)*1
/RESULT_NAME=RIGHT_HIP_FLX_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Trunk Flexion at Initial Contact (Padua Item 3)
Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::RIGHT_TRUNK_FLX_IC < 10)*1
/RESULT_NAME=RIGHT_TRUNK_FLX_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Ankle Plantar-Flexion at Initial Contact (Padua Item 4)
! Going to use Foot Segment Angle here
Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::LEFT_FOOT_FLX_IC > METRIC::PROCESSED::LEFT_FOOT_ANGLE_MEDIAN)*1
/RESULT_NAME=LEFT_FOOT_FLX_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::RIGHT_FOOT_FLX_IC > METRIC::PROCESSED::RIGHT_FOOT_ANGLE_MEDIAN)*1
/RESULT_NAME=RIGHT_FOOT_FLX_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Asymmetrical Contact Timing (~Padua Item 11A)
! Lagging foot is error
Evaluate_Expression
/EXPRESSION=0+((METRIC::LESS_VALUES::LEFT_FOOT_TIME_IC - METRIC::LESS_VALUES::RIGHT_FOOT_TIME_IC) > 0.034)*1
/RESULT_NAME=LEFT_FOOT_TIME_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0+((METRIC::LESS_VALUES::RIGHT_FOOT_TIME_IC - METRIC::LESS_VALUES::LEFT_FOOT_TIME_IC) > 0.034)*1
/RESULT_NAME=RIGHT_FOOT_TIME_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! PADUA_ITEM_11_B_ERROR
! If one foot lands flat or heel to toe (flexion >= 0) and the other lands toe to heel (flexion < 0)
Evaluate_Expression
/EXPRESSION=0 + (((METRIC::LESS_ERRORS::LEFT_FOOT_FLX_IC_ERROR - METRIC::LESS_ERRORS::RIGHT_FOOT_FLX_IC_ERROR) > 0) * 1)
/RESULT_NAME=LEFT_HEELTOE_TOEHEEL_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0 +(((METRIC::LESS_ERRORS::RIGHT_FOOT_FLX_IC_ERROR - METRIC::LESS_ERRORS::LEFT_FOOT_FLX_IC_ERROR) > 0) * 1) 
/RESULT_NAME=RIGHT_HEELTOE_TOEHEEL_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Lateral Trunk Flexion at Initial Contact (Padua Item 6)
Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::RIGHT_TRUNK_LAT_IC < -5)*1
/RESULT_NAME=LEFT_TRUNK_LAT_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::RIGHT_TRUNK_LAT_IC > 5)*1
/RESULT_NAME=RIGHT_TRUNK_LAT_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Stance Width: Wide at Initial Contact (Padua Item 7)
Evaluate_Expression
/EXPRESSION=0+((((METRIC::LESS_VALUES::STANCE_WIDTH_IC - METRIC::LESS_VALUES::SHOULDER_WIDTH)/METRIC::LESS_VALUES::SHOULDER_WIDTH)*100) > 15)*1
/RESULT_NAME=STANCE_WIDTH_WIDE_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Stance Width: Narrow at Initial Contact (Padua Item 8)
Evaluate_Expression
/EXPRESSION=0+((((METRIC::LESS_VALUES::STANCE_WIDTH_IC - METRIC::LESS_VALUES::SHOULDER_WIDTH)/METRIC::LESS_VALUES::SHOULDER_WIDTH)*100) < -12)*1
/RESULT_NAME=STANCE_WIDTH_NARROW_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Knee Valgus at Initial Contact or Medial Knee Position at Initial Contact (Padua Item 5)
! If Knee Joint Center is More Medial than Ankle Joint Center, Error

! Left side: More Medial = More Positive
! If knee position - ankle position is positive, knee is more medial
Evaluate_Expression
/EXPRESSION=0 +(((METRIC::LESS_VALUES::LEFT_KNEE_POS_IC - METRIC::LESS_VALUES::LEFT_ANKLE_POS_IC) > 0) * 1) 
!/EXPRESSION=0 +(((METRIC::LESS_VALUES::LEFT_KNEE_ADD_IC) < 0) * 1)
/RESULT_NAME=LEFT_KNEE_ADD_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Right side: More Medial = More Negative
! If knee position - ankle position is negative, knee is more medial
Evaluate_Expression
/EXPRESSION=0 +(((METRIC::LESS_VALUES::RIGHT_KNEE_POS_IC - METRIC::LESS_VALUES::RIGHT_ANKLE_POS_IC) < 0) * 1)
!/EXPRESSION=0 +(((METRIC::LESS_VALUES::RIGHT_KNEE_ADD_IC) < 0) * 1) 
/RESULT_NAME=RIGHT_KNEE_ADD_IC_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Foot Position: Toe In (Padua Item 9)
Evaluate_Expression
/EXPRESSION=0+((METRIC::LESS_VALUES::RIGHT_FOOT_ROT_MAX > 10)*1)
/RESULT_NAME=RIGHT_FOOT_INT_ROT_MAX_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0+((METRIC::LESS_VALUES::LEFT_FOOT_ROT_MAX > 10)*1)
/RESULT_NAME=LEFT_FOOT_INT_ROT_MAX_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Foot Position: Toe Out (Padua Item 10)
Evaluate_Expression
/EXPRESSION=0+((METRIC::LESS_VALUES::LEFT_FOOT_ROT_MAX < -15)*1)
/RESULT_NAME=LEFT_FOOT_EXT_ROT_MAX_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0+((METRIC::LESS_VALUES::RIGHT_FOOT_ROT_MAX < -15)*1)
/RESULT_NAME=RIGHT_FOOT_EXT_ROT_MAX_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Knee Flexion Displacement (Padua Item 12)
Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::LEFT_KNEE_FLX_MAX < 65)*1
/RESULT_NAME=LEFT_KNEE_FLX_MAX_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::RIGHT_KNEE_FLX_MAX < 65)*1
/RESULT_NAME=RIGHT_KNEE_FLX_MAX_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Hip Flexion Displacement (~Padua Item 13)
Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::LEFT_HIP_FLX_MAX < 45)*1
/RESULT_NAME=LEFT_HIP_FLX_MAX_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::RIGHT_HIP_FLX_MAX < 45)*1
/RESULT_NAME=RIGHT_HIP_FLX_MAX_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Trunk Flexion Displacement (~Padua Item 14)
Evaluate_Expression
/EXPRESSION=0+(METRIC::LESS_VALUES::RIGHT_TRUNK_FLX_DISP < 10)*1
/RESULT_NAME=RIGHT_TRUNK_FLX_DISP_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Knee Valgus Displacement or Maximum Medial Knee Position (~Padua Item 15)
! If at any point during the landing phase the Knee Joint Center is More Medial than the Ankle Joint Center

! Left side: More Medial = More Positive
! If knee position - ankle position is positive, knee is more medial
Evaluate_Expression
/EXPRESSION=0 +(((METRIC::LESS_VALUES::LEFT_KNEE_VS_ANKLE_DIFF_MAX) > 0) * 1) 
!/EXPRESSION=0 +(((METRIC::LESS_VALUES::LEFT_KNEE_ADD_MAX) < 0) * 1) 
/RESULT_NAME=LEFT_KNEE_ADD_MAX_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Right side: More Medial = More Negative
! If knee position - ankle position is negative, knee is more medial
Evaluate_Expression
/EXPRESSION=0 +(((METRIC::LESS_VALUES::RIGHT_KNEE_VS_ANKLE_DIFF_MAX) < 0) * 1)
!/EXPRESSION=0 +(((METRIC::LESS_VALUES::RIGHT_KNEE_ADD_MAX) < 0) * 1) 
/RESULT_NAME=RIGHT_KNEE_ADD_MAX_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Joint Displacement (Padua Item 16)
! Right Side
! Soft = No errors for knee, hip, and trunk flexion max position 
Evaluate_Expression
/EXPRESSION=((METRIC::LESS_ERRORS::RIGHT_KNEE_FLX_MAX_ERROR = 0) + (METRIC::LESS_ERRORS::RIGHT_HIP_FLX_MAX_ERROR = 0) + (METRIC::LESS_ERRORS::RIGHT_TRUNK_FLX_DISP_ERROR = 0)) = 3
/RESULT_NAME=RIGHT_JOINT_DISP_SOFT_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Average = one error from either knee, hip, and trunk flexion max position 
Evaluate_Expression
/EXPRESSION=((METRIC::LESS_ERRORS::RIGHT_KNEE_FLX_MAX_ERROR = 1) + (METRIC::LESS_ERRORS::RIGHT_HIP_FLX_MAX_ERROR = 1) + (METRIC::LESS_ERRORS::RIGHT_TRUNK_FLX_DISP_ERROR = 1 )) = 1
/RESULT_NAME=RIGHT_JOINT_DISP_AVERAGE_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Stiff = two errors from either knee, hip, and trunk flexion max position
Evaluate_Expression
/EXPRESSION=((METRIC::LESS_ERRORS::RIGHT_KNEE_FLX_MAX_ERROR = 1) + (METRIC::LESS_ERRORS::RIGHT_HIP_FLX_MAX_ERROR = 1) + (METRIC::LESS_ERRORS::RIGHT_TRUNK_FLX_DISP_ERROR = 1 )) > 1
/RESULT_NAME=RIGHT_JOINT_DISP_STIFF_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! This evaluates to 2 for Stiff, 1 for Average, and 0 for Soft (see multiplers for final score)
! If RIGHT_JOINT_DISP_AVERAGE_ERROR is not 1 and RIGHT_JOINT_DISP_STIFF_ERROR is not 1, the result has to be Soft
Evaluate_Expression
/EXPRESSION=0+((METRIC::LESS_ERRORS::RIGHT_JOINT_DISP_AVERAGE_ERROR = 1)*1) + ((METRIC::LESS_ERRORS::RIGHT_JOINT_DISP_STIFF_ERROR = 1)*2)
/RESULT_NAME=RIGHT_JOINT_DISP_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Left Side
Evaluate_Expression
/EXPRESSION=((METRIC::LESS_ERRORS::LEFT_KNEE_FLX_MAX_ERROR = 0) + (METRIC::LESS_ERRORS::LEFT_HIP_FLX_MAX_ERROR = 0) + (METRIC::LESS_ERRORS::RIGHT_TRUNK_FLX_DISP_ERROR = 0)) = 3
/RESULT_NAME=LEFT_JOINT_DISP_SOFT_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=((METRIC::LESS_ERRORS::LEFT_KNEE_FLX_MAX_ERROR = 1) + (METRIC::LESS_ERRORS::LEFT_HIP_FLX_MAX_ERROR = 1) + (METRIC::LESS_ERRORS::RIGHT_TRUNK_FLX_DISP_ERROR = 1 )) = 1
/RESULT_NAME=LEFT_JOINT_DISP_AVERAGE_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=((METRIC::LESS_ERRORS::LEFT_KNEE_FLX_MAX_ERROR = 1) + (METRIC::LESS_ERRORS::LEFT_HIP_FLX_MAX_ERROR = 1) + (METRIC::LESS_ERRORS::RIGHT_TRUNK_FLX_DISP_ERROR = 1 )) > 1
/RESULT_NAME=LEFT_JOINT_DISP_STIFF_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0+((METRIC::LESS_ERRORS::LEFT_JOINT_DISP_AVERAGE_ERROR = 1)*1) + ((METRIC::LESS_ERRORS::LEFT_JOINT_DISP_STIFF_ERROR = 1)*2)
/RESULT_NAME=LEFT_JOINT_DISP_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Overall Impression (Padua Item 17)
! Right Side
! Excellent = Joint displacement error classified as Soft and no errors in frontal plane knee
Evaluate_Expression
/EXPRESSION=((METRIC::LESS_ERRORS::RIGHT_JOINT_DISP_ERROR = 0) + (METRIC::LESS_ERRORS::RIGHT_KNEE_ADD_IC_ERROR = 0) + (METRIC::LESS_ERRORS::RIGHT_KNEE_ADD_MAX_ERROR = 0)) = 3
/RESULT_NAME=RIGHT_OVERALL_EXCE_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Poor = Errors for any of knee flexion OR hip flexion OR trunk flexion max position AND error for either knee valgus at initial contact OR knee valgus max position
! Needs to evaluate to greater than 1
Evaluate_Expression
/EXPRESSION=((((METRIC::LESS_ERRORS::RIGHT_KNEE_FLX_MAX_ERROR = 1 + METRIC::LESS_ERRORS::RIGHT_HIP_FLX_MAX_ERROR = 1 + METRIC::LESS_ERRORS::RIGHT_TRUNK_FLX_DISP_ERROR = 1) > 0 ) * 1) + (((METRIC::LESS_ERRORS::RIGHT_KNEE_ADD_IC_ERROR = 1 + METRIC::LESS_ERRORS::RIGHT_KNEE_ADD_MAX_ERROR = 1) > 0 ) * 1)) > 1
/RESULT_NAME=RIGHT_OVERALL_POOR_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Average = if not classified as Excellent or Poor
Evaluate_Expression
/EXPRESSION=(METRIC::LESS_ERRORS::RIGHT_OVERALL_EXCE_ERROR = 0 + METRIC::LESS_ERRORS::RIGHT_OVERALL_POOR_ERROR = 0) = 0
/RESULT_NAME=RIGHT_OVERALL_AVERAGE_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! This evaluates to 2 for Poor, 1 for Average, and 0 for Excellent (see multiplers for final score)
! If RIGHT_OVERALL_AVERAGE_ERROR is not 1 and RIGHT_OVERALL_POOR_ERROR is not 1, the result has to be Excellent
Evaluate_Expression
/EXPRESSION=0+((METRIC::LESS_ERRORS::RIGHT_OVERALL_AVERAGE_ERROR = 1)*1) + ((METRIC::LESS_ERRORS::RIGHT_OVERALL_POOR_ERROR = 1)*2)
/RESULT_NAME=RIGHT_OVERALL_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! Left Side
Evaluate_Expression
/EXPRESSION=((METRIC::LESS_ERRORS::LEFT_JOINT_DISP_ERROR = 0) + (METRIC::LESS_ERRORS::LEFT_KNEE_ADD_IC_ERROR = 0) + (METRIC::LESS_ERRORS::LEFT_KNEE_ADD_MAX_ERROR = 0)) = 3
/RESULT_NAME=LEFT_OVERALL_EXCE_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=((((METRIC::LESS_ERRORS::LEFT_KNEE_FLX_MAX_ERROR = 1 + METRIC::LESS_ERRORS::LEFT_HIP_FLX_MAX_ERROR = 1 + METRIC::LESS_ERRORS::RIGHT_TRUNK_FLX_DISP_ERROR = 1) > 0 ) * 1) + (((METRIC::LESS_ERRORS::LEFT_KNEE_ADD_IC_ERROR = 1 + METRIC::LESS_ERRORS::LEFT_KNEE_ADD_MAX_ERROR = 1) > 0 ) * 1)) > 1
/RESULT_NAME=LEFT_OVERALL_POOR_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=(METRIC::LESS_ERRORS::LEFT_OVERALL_EXCE_ERROR = 0 + METRIC::LESS_ERRORS::LEFT_OVERALL_POOR_ERROR = 0) = 0
/RESULT_NAME=LEFT_OVERALL_AVERAGE_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

Evaluate_Expression
/EXPRESSION=0+((METRIC::LESS_ERRORS::LEFT_OVERALL_AVERAGE_ERROR = 1)*1) + ((METRIC::LESS_ERRORS::LEFT_OVERALL_POOR_ERROR = 1)*2)
/RESULT_NAME=LEFT_OVERALL_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! PADUA_ITEM_11_A_ERROR
! If one foot lands before the other
Evaluate_Expression
/EXPRESSION=0+(((METRIC::LESS_ERRORS::LEFT_FOOT_TIME_IC_ERROR + METRIC::LESS_ERRORS::RIGHT_FOOT_TIME_IC_ERROR) > 0) * 1) 
/RESULT_NAME=PADUA_ITEM_11A_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! PADUA_ITEM_11_B_ERROR
! If one foot lands flat or heel to toe (flexion >= 0) and the other lands toe to heel (flexion < 0)
Evaluate_Expression
/EXPRESSION=0 + (((METRIC::LESS_ERRORS::LEFT_HEELTOE_TOEHEEL_IC_ERROR + METRIC::LESS_ERRORS::RIGHT_HEELTOE_TOEHEEL_IC_ERROR)  > 0) * 1) 
/RESULT_NAME=PADUA_ITEM_11B_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

! PADUA_ITEM_11_ERROR
! If one foot lands before the other or if one foot lands flat/heel to toe and the other lands toe to heel
Evaluate_Expression
/EXPRESSION=0 + (((METRIC::LESS_ERRORS::PADUA_ITEM_11A_ERROR + METRIC::LESS_ERRORS::PADUA_ITEM_11B_ERROR) > 0)*1)
/RESULT_NAME=PADUA_ITEM_11_ERROR
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

