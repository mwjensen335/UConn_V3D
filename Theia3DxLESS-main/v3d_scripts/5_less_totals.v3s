! TOTAL
Evaluate_Expression
/EXPRESSION=0 +
(((METRIC::LESS_ERRORS::RIGHT_KNEE_FLX_IC_ERROR + METRIC::LESS_ERRORS::LEFT_KNEE_FLX_IC_ERROR) > 0)*1) +
(((METRIC::LESS_ERRORS::RIGHT_HIP_FLX_IC_ERROR + METRIC::LESS_ERRORS::LEFT_HIP_FLX_IC_ERROR) > 0)*1) +
METRIC::LESS_ERRORS::RIGHT_TRUNK_FLX_IC_ERROR +
(((METRIC::LESS_ERRORS::RIGHT_FOOT_FLX_IC_ERROR + METRIC::LESS_ERRORS::LEFT_FOOT_FLX_IC_ERROR) > 0)*1) +
(((METRIC::LESS_ERRORS::RIGHT_KNEE_ADD_IC_ERROR + METRIC::LESS_ERRORS::LEFT_KNEE_ADD_IC_ERROR) > 0)*1) +
((METRIC::LESS_ERRORS::LEFT_TRUNK_LAT_IC_ERROR*1) + (METRIC::LESS_ERRORS::RIGHT_TRUNK_LAT_IC_ERROR*1)) +
METRIC::LESS_ERRORS::STANCE_WIDTH_WIDE_IC_ERROR + 
METRIC::LESS_ERRORS::STANCE_WIDTH_NARROW_IC_ERROR + 
(((METRIC::LESS_ERRORS::RIGHT_FOOT_EXT_ROT_MAX_ERROR + METRIC::LESS_ERRORS::LEFT_FOOT_EXT_ROT_MAX_ERROR) > 0)*1) +
(((METRIC::LESS_ERRORS::RIGHT_FOOT_INT_ROT_MAX_ERROR + METRIC::LESS_ERRORS::LEFT_FOOT_INT_ROT_MAX_ERROR) > 0)*1) +
METRIC::LESS_ERRORS::PADUA_ITEM_11_ERROR + 
(((METRIC::LESS_ERRORS::RIGHT_KNEE_FLX_MAX_ERROR + METRIC::LESS_ERRORS::LEFT_KNEE_FLX_MAX_ERROR) > 0)*1) +
(((METRIC::LESS_ERRORS::RIGHT_HIP_FLX_MAX_ERROR + METRIC::LESS_ERRORS::LEFT_HIP_FLX_MAX_ERROR) > 0)*1) +
