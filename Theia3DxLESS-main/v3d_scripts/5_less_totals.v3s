(((METRIC::LESS_ERRORS::RIGHT_KNEE_ADD_MAX_ERROR + METRIC::LESS_ERRORS::LEFT_KNEE_ADD_MAX_ERROR) > 0)*1) +
((METRIC::LESS_ERRORS::RIGHT_JOINT_DISP_ERROR >= METRIC::LESS_ERRORS::LEFT_JOINT_DISP_ERROR) * METRIC::LESS_ERRORS::RIGHT_JOINT_DISP_ERROR) +
((METRIC::LESS_ERRORS::RIGHT_JOINT_DISP_ERROR < METRIC::LESS_ERRORS::LEFT_JOINT_DISP_ERROR) * METRIC::LESS_ERRORS::LEFT_JOINT_DISP_ERROR) +
((METRIC::LESS_ERRORS::RIGHT_OVERALL_ERROR >= METRIC::LESS_ERRORS::LEFT_OVERALL_ERROR) * METRIC::LESS_ERRORS::RIGHT_OVERALL_ERROR) +
((METRIC::LESS_ERRORS::RIGHT_OVERALL_ERROR < METRIC::LESS_ERRORS::LEFT_OVERALL_ERROR) * METRIC::LESS_ERRORS::LEFT_OVERALL_ERROR) 
/RESULT_NAME=OVERALL_17ITEM
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_TOTALS
;

