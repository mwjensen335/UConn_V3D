!def majority_vote(average):
!    if average >= 0.5:
!        return 1
!    else:  # average < 0.5
!        return 0

Select_Active_File
/FILE_NAME=ALL_FILES
! /QUERY=
;

Set_Pipeline_Parameter_To_List_Of_Signal_Names
/PARAMETER_NAME=LESS_LIST
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=LESS_ERRORS
!/SIGNAL_MASK=
;

Metric_Mean
/RESULT_METRIC_FOLDER=LESS_GLOBAL
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=LESS_ERRORS
/SIGNAL_NAMES=::LESS_LIST
/COMPONENT_SEQUENCE=ALL
/EVENT_SEQUENCE=
/EXCLUDE_EVENTS=
! /GENERATE_MEAN_AND_STDDEV=TRUE
! /GENERATE_MEAN_AND_STDDEV_ACROSS_SUBJECTS=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

Select_Active_File
/FILE_NAME=GLOBAL
! /QUERY=
;

Set_Pipeline_Parameter_To_List_Of_Signal_Names
/PARAMETER_NAME=SIGNAL_LIST
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=LESS_GLOBAL
/SIGNAL_MASK=*
;

For_Each
/ITERATION_PARAMETER_NAME=INDEX
! /ITERATION_PARAMETER_COUNT_NAME=
 /ITEMS=::SIGNAL_LIST
;

!Set_Pipeline_Parameter_From_Expression
!/PARAMETER_NAME=TEST_LEFT
!/EXPRESSION=STRING_RIGHT("&::INDEX&",6)
!/AS_INTEGER=FALSE
!;

! TOTAL
Evaluate_Expression
/EXPRESSION=(GLOBAL::METRIC::LESS_GLOBAL:&:&::INDEX& >= 0.5) *1 
/RESULT_NAME=::INDEX
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_ERRORS
;

End_For_Each
/ITERATION_PARAMETER_NAME=INDEX
! /ITERATION_PARAMETER_COUNT_NAME=
 /ITEMS=::SIGNAL_LIST
;

! INDIVIDUAL ERROR VALUES FOR REPORT
! Item 1
Evaluate_Expression
/EXPRESSION=0 + (((GLOBAL::METRIC::LESS_ERRORS::RIGHT_KNEE_FLX_IC_ERROR_MEAN + GLOBAL::METRIC::LESS_ERRORS::LEFT_KNEE_FLX_IC_ERROR_MEAN) > 0)*1)
/RESULT_NAME=ITEM_1_KNEE_FLX_IC
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 2
Evaluate_Expression
/EXPRESSION=0 + (((GLOBAL::METRIC::LESS_ERRORS::RIGHT_HIP_FLX_IC_ERROR_MEAN + GLOBAL::METRIC::LESS_ERRORS::LEFT_HIP_FLX_IC_ERROR_MEAN) > 0)*1) 
/RESULT_NAME=ITEM_2_HIP_FLX_IC
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 3
Evaluate_Expression
/EXPRESSION=0 + GLOBAL::METRIC::LESS_ERRORS::RIGHT_TRUNK_FLX_IC_ERROR_MEAN
/RESULT_NAME=ITEM_3_TRUNK_FLX_IC
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 4
Evaluate_Expression
/EXPRESSION=0 + (((GLOBAL::METRIC::LESS_ERRORS::RIGHT_FOOT_FLX_IC_ERROR_MEAN + GLOBAL::METRIC::LESS_ERRORS::LEFT_FOOT_FLX_IC_ERROR_MEAN) > 0)*1) 
/RESULT_NAME=ITEM_4_FOOT_FLX_IC
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 5
Evaluate_Expression
/EXPRESSION=0 + (((GLOBAL::METRIC::LESS_ERRORS::RIGHT_KNEE_ADD_IC_ERROR_MEAN + GLOBAL::METRIC::LESS_ERRORS::LEFT_KNEE_ADD_IC_ERROR_MEAN) > 0)*1) 
/RESULT_NAME=ITEM_5_KNEE_ADD_IC
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 6
Evaluate_Expression
/EXPRESSION=0 + ((GLOBAL::METRIC::LESS_ERRORS::LEFT_TRUNK_LAT_IC_ERROR_MEAN*1) + (GLOBAL::METRIC::LESS_ERRORS::RIGHT_TRUNK_LAT_IC_ERROR_MEAN*1)) 
/RESULT_NAME=ITEM_6_TRUNK_LAT_IC
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 7
Evaluate_Expression
/EXPRESSION=0 + GLOBAL::METRIC::LESS_ERRORS::STANCE_WIDTH_WIDE_IC_ERROR_MEAN 
/RESULT_NAME=ITEM_7_WIDTH_WIDE_IC
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 8
Evaluate_Expression
/EXPRESSION=0 + GLOBAL::METRIC::LESS_ERRORS::STANCE_WIDTH_NARROW_IC_ERROR_MEAN
/RESULT_NAME=ITEM_8_WIDTH_NARROW_IC
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 9
Evaluate_Expression
/EXPRESSION=0 + (((GLOBAL::METRIC::LESS_ERRORS::RIGHT_FOOT_INT_ROT_MAX_ERROR_MEAN + GLOBAL::METRIC::LESS_ERRORS::LEFT_FOOT_INT_ROT_MAX_ERROR_MEAN) > 0)*1) 
/RESULT_NAME=ITEM_9_INT_ROT_MAX
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 10
Evaluate_Expression
/EXPRESSION=0 + (((GLOBAL::METRIC::LESS_ERRORS::RIGHT_FOOT_EXT_ROT_MAX_ERROR_MEAN + GLOBAL::METRIC::LESS_ERRORS::LEFT_FOOT_EXT_ROT_MAX_ERROR_MEAN) > 0)*1) 
/RESULT_NAME=ITEM_10_EXT_ROT_MAX
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 11
Evaluate_Expression
/EXPRESSION=0 + GLOBAL::METRIC::LESS_ERRORS::PADUA_ITEM_11_ERROR_MEAN 
/RESULT_NAME=ITEM_11_ASYM_CONTACT_IC
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 11A
Evaluate_Expression
/EXPRESSION=0 + GLOBAL::METRIC::LESS_ERRORS::PADUA_ITEM_11A_ERROR_MEAN 
/RESULT_NAME=ITEM_11A_CONTACT_TIME_IC
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 11B
Evaluate_Expression
/EXPRESSION=0 + GLOBAL::METRIC::LESS_ERRORS::PADUA_ITEM_11B_ERROR_MEAN 
/RESULT_NAME=ITEM_11B_HTTH_IC
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 12
Evaluate_Expression
/EXPRESSION=0 + (((GLOBAL::METRIC::LESS_ERRORS::RIGHT_KNEE_FLX_MAX_ERROR_MEAN + GLOBAL::METRIC::LESS_ERRORS::LEFT_KNEE_FLX_MAX_ERROR_MEAN) > 0)*1) 
/RESULT_NAME=ITEM_12_KNEE_FLX_MAX
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 13
Evaluate_Expression
/EXPRESSION=0 + (((GLOBAL::METRIC::LESS_ERRORS::RIGHT_HIP_FLX_MAX_ERROR_MEAN + GLOBAL::METRIC::LESS_ERRORS::LEFT_HIP_FLX_MAX_ERROR_MEAN) > 0)*1) 
/RESULT_NAME=ITEM_13_HIP_FLX_MAX
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 14
Evaluate_Expression
/EXPRESSION=0 + GLOBAL::METRIC::LESS_ERRORS::RIGHT_TRUNK_FLX_DISP_ERROR_MEAN 
/RESULT_NAME=ITEM_14_TRUNK_FLX_DISP
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 15
Evaluate_Expression
/EXPRESSION=0 + (((GLOBAL::METRIC::LESS_ERRORS::RIGHT_KNEE_ADD_MAX_ERROR_MEAN + GLOBAL::METRIC::LESS_ERRORS::LEFT_KNEE_ADD_MAX_ERROR_MEAN) > 0)*1) 
/RESULT_NAME=ITEM_15_KNEE_ADD_MAX
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 16
Evaluate_Expression
/EXPRESSION=0 + ((GLOBAL::METRIC::LESS_ERRORS::RIGHT_JOINT_DISP_ERROR_MEAN >= GLOBAL::METRIC::LESS_ERRORS::LEFT_JOINT_DISP_ERROR_MEAN) * GLOBAL::METRIC::LESS_ERRORS::RIGHT_JOINT_DISP_ERROR_MEAN) +
((GLOBAL::METRIC::LESS_ERRORS::RIGHT_JOINT_DISP_ERROR_MEAN < GLOBAL::METRIC::LESS_ERRORS::LEFT_JOINT_DISP_ERROR_MEAN) * GLOBAL::METRIC::LESS_ERRORS::LEFT_JOINT_DISP_ERROR_MEAN)
/RESULT_NAME=ITEM_16_JOINT_DISP
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Item 17
Evaluate_Expression
/EXPRESSION=0 + ((GLOBAL::METRIC::LESS_ERRORS::RIGHT_OVERALL_ERROR_MEAN >= GLOBAL::METRIC::LESS_ERRORS::LEFT_OVERALL_ERROR_MEAN) * GLOBAL::METRIC::LESS_ERRORS::RIGHT_OVERALL_ERROR_MEAN) +
((GLOBAL::METRIC::LESS_ERRORS::RIGHT_OVERALL_ERROR_MEAN < GLOBAL::METRIC::LESS_ERRORS::LEFT_OVERALL_ERROR_MEAN) * GLOBAL::METRIC::LESS_ERRORS::LEFT_OVERALL_ERROR_MEAN) 
/RESULT_NAME=ITEM_17_OVERALL
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

! Tally
Evaluate_Expression
/EXPRESSION=0 + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_1_KNEE_FLX_IC + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_2_HIP_FLX_IC + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_3_TRUNK_FLX_IC + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_4_FOOT_FLX_IC + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_5_KNEE_ADD_IC + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_6_TRUNK_LAT_IC + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_7_WIDTH_WIDE_IC + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_8_WIDTH_NARROW_IC + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_9_INT_ROT_MAX+ 
GLOBAL::METRIC::LESS_OVERALL::ITEM_10_EXT_ROT_MAX + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_11_ASYM_CONTACT_IC + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_12_KNEE_FLX_MAX + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_13_HIP_FLX_MAX + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_14_TRUNK_FLX_DISP + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_15_KNEE_ADD_MAX + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_16_JOINT_DISP + 
GLOBAL::METRIC::LESS_OVERALL::ITEM_17_OVERALL
/RESULT_NAME=OVERALL_17ITEM
/RESULT_TYPE=METRIC
/RESULT_FOLDER=LESS_OVERALL
;

